# Copy to .env and fill in. Run `npm run vapid` to make the two VAPID keys.
DATABASE_URL="postgresql://user:password@host:5432/toolswap"
APP_URL="https://your-domain.example"
APP_TIMEZONE="America/Chicago"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACT="mailto:you@example.com"
RESEND_API_KEY=""
EMAIL_FROM="ToolSwap <no-reply@your-domain.example>"
